# ──────────────────────────────────────────────────────────────────────────────
# CRM – example environment file
#
# Copy to .env and fill in real values:
#   cp .env.example .env        (Linux / macOS)
#   Copy-Item .env.example .env (PowerShell)
#
# .env is gitignored. Never commit real credentials.
# ──────────────────────────────────────────────────────────────────────────────

# ─── MySQL ────────────────────────────────────────────────────────────────────
# DB_HOST must stay localhost for a local run, and become the MySQL service name
# under Docker Compose, or the MySQL StatefulSet service under Kubernetes.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me

# ─── Service discovery ────────────────────────────────────────────────────────
EUREKA_SERVICE_URL=http://localhost:8761/eureka/

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be Base64 decoding to at least 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET_KEY=replace-with-a-base64-32-byte-key
# Token lifetime in milliseconds. 8640000 is 2 h 24 min.
JWT_EXPIRATION_MS=8640000

# ─── Outbound file storage ───────────────────────────────────────────────────
# The default path does not exist in the runtime image, where the application
# only contains its jar. In a container, mount a volume and point at it.
FILE_UPLOAD_DIR=./uploads

# ─── Mail (Gmail SMTP) ────────────────────────────────────────────────────────
# Requires a Google App Password, not the account password.
# https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password

# ─── Twilio (SMS, used by the Notification service) ───────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ─── Frontend URLs used in outbound e-mails ───────────────────────────────────
ACTIVATION_URL=http://localhost:4200/activate-account

# ─── CORS, enforced by the API Gateway ────────────────────────────────────────
# The browser-facing origin of the frontend. A single value, no trailing slash.
CORS_ALLOWED_ORIGIN=http://localhost:4200

# ─── Administrator bootstrap ─────────────────────────────────────────────────
# Creates the USER and ADMIN roles, and one administrator, on first start.
# Disabled by default so no environment ends up with a known credential.
# To create an administrator on purpose:
#   BOOTSTRAP_ADMIN_ENABLED=true
#   BOOTSTRAP_ADMIN_EMAIL=you@example.com
#   BOOTSTRAP_ADMIN_PASSWORD=<strong password>
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
