# ──────────────────────────────────────────────────────────────────────────────
# CRM – Environment Variables
# Copy this file to .env and fill in the values before running docker-compose.
# ──────────────────────────────────────────────────────────────────────────────

# MySQL / Database
DB_USERNAME=root
DB_PASSWORD=your_strong_db_password

# JWT
JWT_SECRET_KEY=your_256bit_or_longer_secret_key_here

# Mail (Gmail SMTP)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Twilio (optional – used by Notification Service)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# CORS – origin allowed by the API Gateway (browser-facing URL of the frontend)
CORS_ALLOWED_ORIGIN=http://localhost:4200
